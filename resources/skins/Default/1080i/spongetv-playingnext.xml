<?xml version="1.0" encoding="UTF-8"?>
<!-- SpongeTV Playing Next: a card in the bottom-right corner over the video. -->
<window>
    <defaultcontrol always="true">4001</defaultcontrol>
    <animation type="WindowOpen" reversible="false">
        <effect type="slide" start="0,40" end="0,0" time="250" tween="cubic" easing="out"/>
        <effect type="fade" start="0" end="100" time="250"/>
    </animation>
    <animation type="WindowClose" reversible="false">
        <effect type="fade" start="100" end="0" time="200"/>
    </animation>
    <controls>
        <control type="group">
            <left>1110</left><top>676</top>
            <control type="image">
                <left>0</left><top>0</top><width>770</width><height>340</height>
                <texture border="20" colordiffuse="FF24406A">spongetv-round.png</texture>
            </control>
            <control type="image">
                <left>3</left><top>3</top><width>764</width><height>334</height>
                <texture border="20" colordiffuse="F212233F">spongetv-round.png</texture>
            </control>
            <!-- episode still -->
            <control type="image">
                <left>28</left><top>28</top><width>280</width><height>158</height>
                <texture>$INFO[Window.Property(thumb)]</texture>
                <aspectratio>scale</aspectratio>
            </control>
            <control type="label">
                <left>332</left><top>24</top><width>410</width><height>34</height>
                <font>font12</font><textcolor>FFF5A524</textcolor>
                <label>$INFO[Window.Property(heading)]</label>
            </control>
            <control type="label">
                <left>332</left><top>60</top><width>410</width><height>40</height>
                <font>font13</font><textcolor>FFEAF2FB</textcolor>
                <label>$INFO[Window.Property(show)]</label>
            </control>
            <control type="textbox">
                <left>332</left><top>102</top><width>410</width><height>84</height>
                <font>font12</font><textcolor>FFA9BCD6</textcolor>
                <label>$INFO[Window.Property(episode)]</label>
            </control>
            <!-- countdown -->
            <control type="progress" id="4100">
                <left>28</left><top>206</top><width>714</width><height>10</height>
                <texturebg colordiffuse="FF24406A">spongetv-white.png</texturebg>
                <midtexture colordiffuse="FFF5A524">spongetv-white.png</midtexture>
            </control>
            <control type="label">
                <left>28</left><top>222</top><width>714</width><height>32</height>
                <font>font12</font><textcolor>FF2EC4B6</textcolor>
                <label>$INFO[Window.Property(status)]</label>
            </control>
            <!-- buttons -->
            <control type="button" id="4001">
                <left>28</left><top>262</top><width>330</width><height>56</height>
                <font>font12</font><textcolor>FF0A1428</textcolor><focusedcolor>FF0A1428</focusedcolor>
                <align>center</align><aligny>center</aligny>
                <texturenofocus border="20" colordiffuse="CCF5A524">spongetv-pill.png</texturenofocus>
                <texturefocus border="20" colordiffuse="FFF5A524">spongetv-pill.png</texturefocus>
                <label>$INFO[Window.Property(play_now)]</label>
                <onright>4002</onright>
            </control>
            <control type="button" id="4002">
                <left>374</left><top>262</top><width>368</width><height>56</height>
                <font>font12</font><textcolor>FFEAF2FB</textcolor><focusedcolor>FF0A1428</focusedcolor>
                <align>center</align><aligny>center</aligny>
                <texturenofocus border="20" colordiffuse="FF24406A">spongetv-pill.png</texturenofocus>
                <texturefocus border="20" colordiffuse="FFF5A524">spongetv-pill.png</texturefocus>
                <label>$INFO[Window.Property(stop_after)]</label>
                <onleft>4001</onleft>
            </control>
        </control>
    </controls>
</window>
