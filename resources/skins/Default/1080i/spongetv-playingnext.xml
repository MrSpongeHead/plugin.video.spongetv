<?xml version="1.0" encoding="UTF-8"?>
<!-- SpongeTV Playing Next, a card over the video, from the approved mock-up. Written by tools/make_windows.py. -->
<window>
    <defaultcontrol always="true">4001</defaultcontrol>
    <animation type="WindowOpen" reversible="false">
        <effect type="slide" start="0,40" end="0,0" time="250" tween="cubic" easing="out"/>
        <effect type="fade" start="0" end="100" time="250"/>
    </animation>
    <animation type="WindowClose" reversible="false">
        <effect type="fade" start="100" end="0" time="200"/>
    </animation>
    <controls>
        <control type="image">
            <left>1020</left><top>678</top><width>820</width><height>322</height>
