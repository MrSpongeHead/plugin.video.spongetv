                <control type="label">
                    <left>1150</left><top>28</top><width>160</width><height>48</height>
                    <font>font12</font><textcolor>FFA9BCD6</textcolor><aligny>center</aligny>
                    <label>$INFO[ListItem.Property(from)]</label>
                </control>
            </focusedlayout>
        </control>

        <!-- remote hints and ranking note -->
        <control type="label">
            <left>540</left><top>978</top><width>1320</width><height>40</height>
            <font>font12</font><textcolor>FFA9BCD6</textcolor>
            <label>$INFO[Window.Property(hints)]</label>
        </control>
