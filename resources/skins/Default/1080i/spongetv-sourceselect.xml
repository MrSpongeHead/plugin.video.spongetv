<?xml version="1.0" encoding="UTF-8"?>
<!-- SpongeTV Source Select. Colours from the approved design: navy base, amber selection, teal "good". -->
<window>
    <defaultcontrol always="true">1000</defaultcontrol>
    <animation type="WindowOpen" reversible="false">
        <effect type="fade" start="0" end="100" time="200"/>
    </animation>
    <animation type="WindowClose" reversible="false">
        <effect type="fade" start="100" end="0" time="150"/>
    </animation>
    <controls>
        <!-- background -->
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="FF0A1428">spongetv-white.png</texture>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture>$INFO[Window.Property(fanart)]</texture>
            <aspectratio>scale</aspectratio>
            <colordiffuse>1AFFFFFF</colordiffuse>
        </control>

        <!-- header -->
        <control type="label">
            <left>80</left><top>48</top><width>1100</width><height>60</height>
            <font>font37</font><textcolor>FFEAF2FB</textcolor>
            <label>$INFO[Window.Property(heading)]</label>
        </control>
        <control type="label">
            <left>80</left><top>108</top><width>1100</width><height>40</height>
            <font>font13</font><textcolor>FFA9BCD6</textcolor>
            <label>$INFO[Window.Property(subheading)]</label>
        </control>
        <control type="button" id="2002">
            <left>1240</left><top>60</top><width>300</width><height>64</height>
            <font>font13</font><textcolor>FFEAF2FB</textcolor><focusedcolor>FF0A1428</focusedcolor>
            <align>center</align><aligny>center</aligny>
            <texturenofocus border="20" colordiffuse="FF12233F">spongetv-pill.png</texturenofocus>
            <texturefocus border="20" colordiffuse="FFF5A524">spongetv-pill.png</texturefocus>
            <label>$INFO[Window.Property(filter_label)]</label>
            <onright>2003</onright><ondown>1000</ondown>
        </control>
        <control type="button" id="2003">
            <left>1560</left><top>60</top><width>280</width><height>64</height>
            <font>font13</font><textcolor>FFEAF2FB</textcolor><focusedcolor>FF0A1428</focusedcolor>
            <align>center</align><aligny>center</aligny>
            <texturenofocus border="20" colordiffuse="FF12233F">spongetv-pill.png</texturenofocus>
            <texturefocus border="20" colordiffuse="FFF5A524">spongetv-pill.png</texturefocus>
            <label>$INFO[Window.Property(sort_label)]</label>
            <onleft>2002</onleft><ondown>1000</ondown>
        </control>

        <!-- left: what you're watching -->
        <control type="image">
            <left>80</left><top>180</top><width>420</width><height>800</height>
            <texture border="20" colordiffuse="FF12233F">spongetv-round.png</texture>
        </control>
        <control type="image">
            <left>110</left><top>210</top><width>360</width><height>520</height>
            <texture>$INFO[Window.Property(poster)]</texture>
            <aspectratio>keep</aspectratio>
        </control>
        <control type="textbox">
            <left>110</left><top>744</top><width>360</width><height>84</height>
            <font>font27</font><textcolor>FFEAF2FB</textcolor>
            <label>$INFO[Window.Property(title)]</label>
        </control>
        <control type="label">
            <left>110</left><top>832</top><width>360</width><height>36</height>
            <font>font12</font><textcolor>FFA9BCD6</textcolor>
            <label>$INFO[Window.Property(meta)]</label>
        </control>
        <control type="button" id="2001">
            <left>110</left><top>888</top><width>360</width><height>68</height>
            <font>font13</font><textcolor>FF0A1428</textcolor><focusedcolor>FF0A1428</focusedcolor>
            <align>center</align><aligny>center</aligny>
            <texturenofocus border="20" colordiffuse="CCF5A524">spongetv-pill.png</texturenofocus>
            <texturefocus border="20" colordiffuse="FFF5A524">spongetv-pill.png</texturefocus>
            <label>$INFO[Window.Property(play_best)]</label>
            <onright>1000</onright><onup>2002</onup>
        </control>

        <!-- right: the sources -->
        <control type="label">
            <left>560</left><top>180</top><width>140</width><height>40</height>
            <font>font12</font><textcolor>FF8FA6C4</textcolor>
            <label>$INFO[Window.Property(col_quality)]</label>
        </control>
        <control type="label">
            <left>724</left><top>180</top><width>640</width><height>40</height>
            <font>font12</font><textcolor>FF8FA6C4</textcolor>
            <label>$INFO[Window.Property(col_release)]</label>
        </control>
        <control type="label">
            <left>1380</left><top>180</top><width>130</width><height>40</height>
            <font>font12</font><textcolor>FF8FA6C4</textcolor>
            <label>$INFO[Window.Property(col_size)]</label>
        </control>
        <control type="label">
            <left>1520</left><top>180</top><width>160</width><height>40</height>
            <font>font12</font><textcolor>FF8FA6C4</textcolor>
            <label>$INFO[Window.Property(col_status)]</label>
        </control>
        <control type="label">
            <left>1690</left><top>180</top><width>170</width><height>40</height>
            <font>font12</font><textcolor>FF8FA6C4</textcolor>
            <label>$INFO[Window.Property(col_from)]</label>
        </control>
        <control type="list" id="1000">
            <left>540</left><top>224</top><width>1320</width><height>728</height>
            <orientation>vertical</orientation>
            <onleft>2001</onleft><onup>2002</onup>
            <scrolltime tween="quadratic">200</scrolltime>
            <itemlayout height="104" width="1320">
                <control type="image">
                    <left>0</left><top>4</top><width>1320</width><height>96</height>
                    <texture border="20" colordiffuse="FF12233F">spongetv-round.png</texture>
                </control>
                <control type="image">
                    <left>20</left><top>28</top><width>120</width><height>48</height>
                    <texture border="12" colordiffuse="FFF5A524">spongetv-round.png</texture>
                    <visible>String.IsEqual(ListItem.Property(quality),4K)</visible>
                </control>
                <control type="label">
                    <left>20</left><top>28</top><width>120</width><height>48</height>
                    <font>font13</font><textcolor>FF0A1428</textcolor><align>center</align><aligny>center</aligny>
                    <label>$INFO[ListItem.Property(quality)]</label>
                    <visible>String.IsEqual(ListItem.Property(quality),4K)</visible>
                </control>
                <control type="image">
                    <left>20</left><top>28</top><width>120</width><height>48</height>
                    <texture border="12" colordiffuse="FF2EC4B6">spongetv-round.png</texture>
                    <visible>String.IsEqual(ListItem.Property(quality),1080p)</visible>
                </control>
                <control type="label">
                    <left>20</left><top>28</top><width>120</width><height>48</height>
                    <font>font13</font><textcolor>FF0A1428</textcolor><align>center</align><aligny>center</aligny>
                    <label>$INFO[ListItem.Property(quality)]</label>
                    <visible>String.IsEqual(ListItem.Property(quality),1080p)</visible>
                </control>
                <control type="image">
                    <left>20</left><top>28</top><width>120</width><height>48</height>
                    <texture border="12" colordiffuse="FF2C4468">spongetv-round.png</texture>
                    <visible>String.IsEqual(ListItem.Property(quality),720p)</visible>
                </control>
                <control type="label">
                    <left>20</left><top>28</top><width>120</width><height>48</height>
                    <font>font13</font><textcolor>FFEAF2FB</textcolor><align>center</align><aligny>center</aligny>
                    <label>$INFO[ListItem.Property(quality)]</label>
                    <visible>String.IsEqual(ListItem.Property(quality),720p)</visible>
                </control>
                <control type="image">
                    <left>20</left><top>28</top><width>120</width><height>48</height>
                    <texture border="12" colordiffuse="FF3A4A60">spongetv-round.png</texture>
                    <visible>!String.IsEqual(ListItem.Property(quality),4K) + !String.IsEqual(ListItem.Property(quality),1080p) + !String.IsEqual(ListItem.Property(quality),720p)</visible>
                </control>
                <control type="label">
                    <left>20</left><top>28</top><width>120</width><height>48</height>
                    <font>font13</font><textcolor>FFEAF2FB</textcolor><align>center</align><aligny>center</aligny>
                    <label>$INFO[ListItem.Property(quality)]</label>
                    <visible>!String.IsEqual(ListItem.Property(quality),4K) + !String.IsEqual(ListItem.Property(quality),1080p) + !String.IsEqual(ListItem.Property(quality),720p)</visible>
                </control>
                <control type="label">
                    <left>184</left><top>14</top><width>640</width><height>42</height>
                    <font>font13</font><textcolor>FFEAF2FB</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <left>184</left><top>56</top><width>640</width><height>34</height>
                    <font>font12</font><textcolor>FFA9BCD6</textcolor>
                    <label>$INFO[ListItem.Label2]</label>
                </control>
                <control type="label">
                    <left>840</left><top>28</top><width>130</width><height>48</height>
                    <font>font13</font><textcolor>FFEAF2FB</textcolor><aligny>center</aligny>
                    <label>$INFO[ListItem.Property(size)]</label>
                </control>
                <control type="label">
                    <left>980</left><top>28</top><width>160</width><height>48</height>
                    <font>font12</font><textcolor>FF2EC4B6</textcolor><aligny>center</aligny>
                    <label>$INFO[ListItem.Property(status)]</label>
                    <visible>String.IsEqual(ListItem.Property(status_kind),cached)</visible>
                </control>
                <control type="label">
                    <left>980</left><top>28</top><width>160</width><height>48</height>
                    <font>font12</font><textcolor>FFDFFAF6</textcolor><aligny>center</aligny>
                    <label>$INFO[ListItem.Property(status)]</label>
                    <visible>String.IsEqual(ListItem.Property(status_kind),cloud)</visible>
                </control>
                <control type="label">
                    <left>980</left><top>28</top><width>160</width><height>48</height>
                    <font>font12</font><textcolor>FF8FA6C4</textcolor><aligny>center</aligny>
                    <label>$INFO[ListItem.Property(status)]</label>
                    <visible>!String.IsEqual(ListItem.Property(status_kind),cached) + !String.IsEqual(ListItem.Property(status_kind),cloud)</visible>
                </control>
                <control type="label">
                    <left>1150</left><top>28</top><width>160</width><height>48</height>
                    <font>font12</font><textcolor>FFA9BCD6</textcolor><aligny>center</aligny>
                    <label>$INFO[ListItem.Property(from)]</label>
                </control>
            </itemlayout>
            <focusedlayout height="104" width="1320">
                <control type="image">
                    <left>0</left><top>4</top><width>1320</width><height>96</height>
                    <texture border="20" colordiffuse="FF1B3358">spongetv-round.png</texture>
                </control>
                <control type="image">
                    <left>0</left><top>4</top><width>1320</width><height>96</height>
                    <texture border="20" colordiffuse="FFF5A524">spongetv-round-outline.png</texture>
                    <visible>Control.HasFocus(1000)</visible>
                </control>
                <control type="image">
                    <left>20</left><top>28</top><width>120</width><height>48</height>
                    <texture border="12" colordiffuse="FFF5A524">spongetv-round.png</texture>
                    <visible>String.IsEqual(ListItem.Property(quality),4K)</visible>
                </control>
                <control type="label">
                    <left>20</left><top>28</top><width>120</width><height>48</height>
                    <font>font13</font><textcolor>FF0A1428</textcolor><align>center</align><aligny>center</aligny>
                    <label>$INFO[ListItem.Property(quality)]</label>
                    <visible>String.IsEqual(ListItem.Property(quality),4K)</visible>
                </control>
                <control type="image">
                    <left>20</left><top>28</top><width>120</width><height>48</height>
                    <texture border="12" colordiffuse="FF2EC4B6">spongetv-round.png</texture>
                    <visible>String.IsEqual(ListItem.Property(quality),1080p)</visible>
                </control>
                <control type="label">
                    <left>20</left><top>28</top><width>120</width><height>48</height>
                    <font>font13</font><textcolor>FF0A1428</textcolor><align>center</align><aligny>center</aligny>
                    <label>$INFO[ListItem.Property(quality)]</label>
                    <visible>String.IsEqual(ListItem.Property(quality),1080p)</visible>
                </control>
                <control type="image">
                    <left>20</left><top>28</top><width>120</width><height>48</height>
                    <texture border="12" colordiffuse="FF2C4468">spongetv-round.png</texture>
                    <visible>String.IsEqual(ListItem.Property(quality),720p)</visible>
                </control>
                <control type="label">
                    <left>20</left><top>28</top><width>120</width><height>48</height>
                    <font>font13</font><textcolor>FFEAF2FB</textcolor><align>center</align><aligny>center</aligny>
                    <label>$INFO[ListItem.Property(quality)]</label>
                    <visible>String.IsEqual(ListItem.Property(quality),720p)</visible>
                </control>
                <control type="image">
                    <left>20</left><top>28</top><width>120</width><height>48</height>
                    <texture border="12" colordiffuse="FF3A4A60">spongetv-round.png</texture>
                    <visible>!String.IsEqual(ListItem.Property(quality),4K) + !String.IsEqual(ListItem.Property(quality),1080p) + !String.IsEqual(ListItem.Property(quality),720p)</visible>
                </control>
                <control type="label">
                    <left>20</left><top>28</top><width>120</width><height>48</height>
                    <font>font13</font><textcolor>FFEAF2FB</textcolor><align>center</align><aligny>center</aligny>
                    <label>$INFO[ListItem.Property(quality)]</label>
                    <visible>!String.IsEqual(ListItem.Property(quality),4K) + !String.IsEqual(ListItem.Property(quality),1080p) + !String.IsEqual(ListItem.Property(quality),720p)</visible>
                </control>
                <control type="label">
                    <left>184</left><top>14</top><width>640</width><height>42</height>
                    <font>font13</font><textcolor>FFEAF2FB</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <left>184</left><top>56</top><width>640</width><height>34</height>
                    <font>font12</font><textcolor>FFA9BCD6</textcolor>
                    <label>$INFO[ListItem.Label2]</label>
                </control>
                <control type="label">
                    <left>840</left><top>28</top><width>130</width><height>48</height>
                    <font>font13</font><textcolor>FFEAF2FB</textcolor><aligny>center</aligny>
                    <label>$INFO[ListItem.Property(size)]</label>
                </control>
                <control type="label">
                    <left>980</left><top>28</top><width>160</width><height>48</height>
                    <font>font12</font><textcolor>FF2EC4B6</textcolor><aligny>center</aligny>
                    <label>$INFO[ListItem.Property(status)]</label>
                    <visible>String.IsEqual(ListItem.Property(status_kind),cached)</visible>
                </control>
                <control type="label">
                    <left>980</left><top>28</top><width>160</width><height>48</height>
                    <font>font12</font><textcolor>FFDFFAF6</textcolor><aligny>center</aligny>
                    <label>$INFO[ListItem.Property(status)]</label>
                    <visible>String.IsEqual(ListItem.Property(status_kind),cloud)</visible>
                </control>
                <control type="label">
                    <left>980</left><top>28</top><width>160</width><height>48</height>
                    <font>font12</font><textcolor>FF8FA6C4</textcolor><aligny>center</aligny>
