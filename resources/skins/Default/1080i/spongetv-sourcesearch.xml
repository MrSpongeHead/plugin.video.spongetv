<?xml version="1.0" encoding="UTF-8"?>
<!-- SpongeTV source search progress: a centred window over the dimmed fanart. -->
<window>
    <defaultcontrol always="true">3001</defaultcontrol>
    <animation type="WindowOpen" reversible="false">
        <effect type="fade" start="0" end="100" time="200"/>
    </animation>
    <controls>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="FF0A1428">spongetv-white.png</texture>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture>$INFO[Window.Property(fanart)]</texture>
            <aspectratio>scale</aspectratio>
            <colordiffuse>59FFFFFF</colordiffuse>
        </control>

        <!-- the panel -->
        <control type="group">
            <left>460</left><top>210</top>
            <control type="image">
                <left>0</left><top>0</top><width>1000</width><height>660</height>
                <texture border="20" colordiffuse="FF24406A">spongetv-round.png</texture>
            </control>
            <control type="image">
                <left>3</left><top>3</top><width>994</width><height>654</height>
                <texture border="20" colordiffuse="F212233F">spongetv-round.png</texture>
            </control>
            <control type="label">
                <left>56</left><top>44</top><width>700</width><height>56</height>
                <font>font37</font><textcolor>FFEAF2FB</textcolor>
                <label>$INFO[Window.Property(heading)]</label>
            </control>
            <control type="label">
                <left>56</left><top>104</top><width>700</width><height>40</height>
                <font>font13</font><textcolor>FFA9BCD6</textcolor>
                <label>$INFO[Window.Property(title)]</label>
            </control>
            <control type="label">
                <left>744</left><top>48</top><width>200</width><height>56</height>
                <font>font37</font><textcolor>FFF5A524</textcolor><align>right</align>
                <label>$INFO[Window.Property(elapsed)]</label>
            </control>

            <!-- progress -->
            <control type="progress" id="3100">
                <left>56</left><top>172</top><width>888</width><height>16</height>
                <texturebg border="6" colordiffuse="FF24406A">spongetv-round.png</texturebg>
                <midtexture border="6" colordiffuse="FFF5A524">spongetv-round.png</midtexture>
            </control>
            <control type="label">
                <left>56</left><top>198</top><width>888</width><height>36</height>
                <font>font12</font><textcolor>FFA9BCD6</textcolor>
                <label>$INFO[Window.Property(providers_line)]</label>
            </control>

            <!-- counts by quality -->
            <control type="grouplist">
                <left>56</left><top>256</top><width>888</width><height>120</height>
                <orientation>horizontal</orientation>
                <itemgap>16</itemgap>
                <usecontrolwidth>true</usecontrolwidth>
                <control type="group">
                    <width>210</width><height>120</height>
                    <control type="image">
                        <width>210</width><height>120</height>
                        <texture border="20" colordiffuse="FF0A1428">spongetv-round.png</texture>
                    </control>
                    <control type="label">
                        <left>24</left><top>16</top><width>170</width><height>34</height>
                        <font>font12</font><textcolor>FFF5A524</textcolor>
                        <label>4K</label>
                    </control>
                    <control type="label">
                        <left>24</left><top>52</top><width>170</width><height>56</height>
                        <font>font37</font><textcolor>FFEAF2FB</textcolor>
                        <label>$INFO[Window.Property(count_4k)]</label>
                    </control>
                </control>
                <control type="group">
                    <width>210</width><height>120</height>
                    <control type="image">
                        <width>210</width><height>120</height>
                        <texture border="20" colordiffuse="FF0A1428">spongetv-round.png</texture>
                    </control>
                    <control type="label">
                        <left>24</left><top>16</top><width>170</width><height>34</height>
                        <font>font12</font><textcolor>FF2EC4B6</textcolor>
                        <label>1080p</label>
                    </control>
                    <control type="label">
                        <left>24</left><top>52</top><width>170</width><height>56</height>
                        <font>font37</font><textcolor>FFEAF2FB</textcolor>
                        <label>$INFO[Window.Property(count_1080p)]</label>
                    </control>
                </control>
                <control type="group">
                    <width>210</width><height>120</height>
                    <control type="image">
                        <width>210</width><height>120</height>
                        <texture border="20" colordiffuse="FF0A1428">spongetv-round.png</texture>
                    </control>
                    <control type="label">
                        <left>24</left><top>16</top><width>170</width><height>34</height>
                        <font>font12</font><textcolor>FFA9BCD6</textcolor>
                        <label>720p</label>
                    </control>
                    <control type="label">
                        <left>24</left><top>52</top><width>170</width><height>56</height>
                        <font>font37</font><textcolor>FFEAF2FB</textcolor>
                        <label>$INFO[Window.Property(count_720p)]</label>
                    </control>
                </control>
                <control type="group">
                    <width>210</width><height>120</height>
                    <control type="image">
                        <width>210</width><height>120</height>
                        <texture border="20" colordiffuse="FF0A1428">spongetv-round.png</texture>
                    </control>
                    <control type="label">
                        <left>24</left><top>16</top><width>170</width><height>34</height>
                        <font>font12</font><textcolor>FF8FA6C4</textcolor>
                        <label>$INFO[Window.Property(other_label)]</label>
                    </control>
                    <control type="label">
                        <left>24</left><top>52</top><width>170</width><height>56</height>
                        <font>font37</font><textcolor>FFEAF2FB</textcolor>
                        <label>$INFO[Window.Property(count_other)]</label>
                    </control>
                </control>
            </control>

            <!-- status lines -->
            <control type="label">
                <left>56</left><top>404</top><width>888</width><height>36</height>
                <font>font13</font><textcolor>FF2EC4B6</textcolor>
                <label>$INFO[Window.Property(ready_line)]</label>
            </control>
            <control type="label">
                <left>56</left><top>444</top><width>888</width><height>36</height>
                <font>font13</font><textcolor>FFEAF2FB</textcolor>
                <label>$INFO[Window.Property(early_line)]</label>
            </control>
            <control type="label">
                <left>56</left><top>484</top><width>888</width><height>36</height>
                <font>font12</font><textcolor>FFA9BCD6</textcolor>
                <label>$INFO[Window.Property(searching_line)]</label>
            </control>

            <!-- buttons -->
            <control type="button" id="3001">
                <left>56</left><top>556</top><width>420</width><height>68</height>
                <font>font13</font><textcolor>FF0A1428</textcolor><focusedcolor>FF0A1428</focusedcolor>
                <disabledcolor>FF8FA6C4</disabledcolor>
                <align>center</align><aligny>center</aligny>
                <texturenofocus border="20" colordiffuse="CCF5A524">spongetv-pill.png</texturenofocus>
                <texturefocus border="20" colordiffuse="FFF5A524">spongetv-pill.png</texturefocus>
                <label>$INFO[Window.Property(choose_label)]</label>
                <enable>!String.IsEmpty(Window.Property(can_choose))</enable>
                <onright>3002</onright>
            </control>
            <control type="button" id="3002">
                <left>500</left><top>556</top><width>240</width><height>68</height>
                <font>font13</font><textcolor>FFEAF2FB</textcolor><focusedcolor>FF0A1428</focusedcolor>
                <align>center</align><aligny>center</aligny>
                <texturenofocus border="20" colordiffuse="FF24406A">spongetv-pill.png</texturenofocus>
                <texturefocus border="20" colordiffuse="FFF5A524">spongetv-pill.png</texturefocus>
                <label>$INFO[Window.Property(cancel_label)]</label>
                <onleft>3001</onleft>
            </control>
        </control>
    </controls>
</window>
